{
  "name": "@amamo/verso-repo",
  "private": true,
  "description": "A focused release CLI for JavaScript workspace packages.",
  "homepage": "https://github.com/jikkai/verso#readme",
  "bugs": {
    "url": "https://github.com/jikkai/verso/issues"
  },
  "license": "MIT",
  "author": "白熱 <sonne@asaki.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jikkai/verso.git"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "precommit": "pnpm run format:check && pnpm run lint",
    "build": "pnpm --filter @amamo/verso build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run check:scripts && pnpm run check:docs && pnpm run check:rust && pnpm run check:npm",
    "check:docs": "pnpm --filter @amamo/verso-docs types:check && pnpm --filter @amamo/verso-docs build",
    "check:npm": "pnpm --filter @amamo/verso typecheck && pnpm --filter @amamo/verso test",
    "check:rust": "cargo fmt --check && cargo clippy --locked --all-targets --all-features -- -D warnings && cargo test --locked --all",
    "check:scripts": "tsc -p tsconfig.json --noEmit",
    "format": "oxfmt . && cargo fmt",
    "format:check": "oxfmt --check . && cargo fmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "docs:dev": "pnpm --filter @amamo/verso-docs dev",
    "docs:build": "pnpm --filter @amamo/verso-docs build",
    "release": "cargo run -p verso"
  },
  "devDependencies": {
    "@amamo/oxlint-config": "1.0.0",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tailwindcss": "^1.7.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run precommit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.20.0"
}
